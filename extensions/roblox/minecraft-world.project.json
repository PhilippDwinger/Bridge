{
  "name": "Bridge MinecraftWorld",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 83.5
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "CreateDefaultCommands": false
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 12.951,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 3.7566,
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MinecraftClient": {
          "$path": "examples/MinecraftWorld/MinecraftClient.client.luau"
        },
        "MinecraftPlayer": {
          "$path": "examples/MinecraftWorld/MinecraftPlayer.client.luau"
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "MinecraftImages": {
        "$path": "examples/MinecraftWorld/MinecraftImages.luau"
      },
      "MinecraftCharacter": {
        "$path": "examples/MinecraftWorld/MinecraftCharacter.luau"
      },
      "MinecraftAnimationIds": {
        "$path": "examples/MinecraftWorld/MinecraftAnimationIds.luau"
      },
      "MinecraftSounds": {
        "$path": "examples/MinecraftWorld/MinecraftSounds.luau"
      },
      "MinecraftSoundIds": {
        "$path": "examples/MinecraftWorld/MinecraftSoundIds.luau"
      },
      "MinecraftAnimations": {
        "$path": "examples/MinecraftWorld/animations"
      },
      "MinecraftShaders": {
        "$path": "examples/MinecraftWorld/MinecraftShaders.luau"
      },
      "MinecraftSky": {
        "$path": "examples/MinecraftWorld/MinecraftSky.luau"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Bridge": {
        "$path": "src/Bridge.luau"
      },
      "MinecraftWorldConfig": {
        "$path": "examples/MinecraftWorld/Config.luau"
      },
      "MinecraftWorldClient": {
        "$path": "examples/MinecraftWorld/Client.luau"
      },
      "PlayerSyncConfig": {
        "$path": "examples/MinecraftWorld/PlayerSyncConfig.luau"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MinecraftWorld": {
        "$path": "examples/MinecraftWorld/MinecraftWorld.server.luau"
      },
      "PlayerSync": {
        "$path": "examples/PlayerSync/PlayerSync.server.luau"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    }
  }
}
